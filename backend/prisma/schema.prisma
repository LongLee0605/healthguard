generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  dateOfBirth  DateTime?
  gender       String?
  height       Float?
  bloodType    String?
  allergies    String?
  chronicConditions String?
  emergencyContact  String?
  emergencyPhone    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  symptomLogs         SymptomLog[]
  vitalSigns          VitalSign[]
  aiAnalyses          AIAnalysis[]
  medicationReminders MedicationReminder[]
  medicationLogs      MedicationLog[]
  healthGoals         HealthGoal[]
  alerts              Alert[]
  chatMessages        ChatMessage[]
  healthDevices       HealthDevice[]
}

model SymptomLog {
  id          String   @id @default(uuid())
  userId      String
  description String
  severity    Int      @default(5)
  bodyPart    String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiAnalyses AIAnalysis[]

  @@index([userId, recordedAt])
}

model VitalSign {
  id              String   @id @default(uuid())
  userId          String
  type            String
  value           Float
  valueSecondary  Float?
  unit            String
  note            String?
  source          String   @default("MANUAL")
  externalId      String?
  deviceName      String?
  syncedAt        DateTime?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@index([userId, source])
  @@unique([userId, source, externalId])
}

model HealthDevice {
  id           String    @id @default(uuid())
  userId       String
  source       String
  deviceName   String    @default("")
  deviceModel  String?
  lastSyncAt   DateTime?
  readingCount Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, deviceName])
  @@index([userId, isActive])
}

model AIAnalysis {
  id                 String   @id @default(uuid())
  userId             String
  symptomLogId       String?
  inputSummary       String
  analysis           String
  suggestedSpecialty String?
  urgencyLevel       String   @default("LOW")
  createdAt          DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptomLog SymptomLog? @relation(fields: [symptomLogId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model MedicationReminder {
  id             String   @id @default(uuid())
  userId         String
  medicationName String
  dosage         String
  schedule       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs MedicationLog[]

  @@index([isActive])
  @@index([userId, isActive])
}

model MedicationLog {
  id            String   @id @default(uuid())
  userId        String
  medicationId  String
  scheduledDate String
  scheduledTime String
  status        String
  loggedAt      DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication MedicationReminder @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, scheduledDate, scheduledTime])
  @@index([userId, loggedAt])
}

model HealthGoal {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  targetCount  Int      @default(1)
  currentCount Int      @default(0)
  unit         String?
  period       String   @default("WEEKLY")
  weekStart    String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  severity  String   @default("MEDIUM")
  sourceId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type, sourceId, createdAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
