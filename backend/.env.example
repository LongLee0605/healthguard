# Database (PostgreSQL) — KHÔNG commit file .env
DATABASE_URL=postgresql://healthguard:healthguard@localhost:5432/healthguard

# Auth — JWT_SECRET >= 32 ký tự trong production
JWT_SECRET=dev-only-change-me-use-random-32-chars-min
JWT_EXPIRES_IN=7d

# CORS — comma-separated: web + Expo dev
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# AI local (Ollama) — không cần API key ngoài
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Sau npm run train:ai dùng healthguard-med; mặc định gốc khuyến nghị:
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_MODEL_CANDIDATES=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=90000
# 1 LLM tại một thời điểm (máy local). Tăng 2 nếu GPU mạnh.
OLLAMA_MAX_CONCURRENT=1

# Postgres pool (Prisma)
DB_POOL_SIZE=20

# Server
PORT=3001
NODE_ENV=development
